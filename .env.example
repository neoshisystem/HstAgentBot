# HstAgentBot Configuration Template
# Copy this file to .env and fill in your actual values.

# Telegram Bot API Token from @BotFather
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ_ExampleToken

# Super Admin Telegram Numeric ID
ADMIN_TELEGRAM_ID=123456789

# Main Supergroup ID (for operational logs, backups, and forum topics)
MAIN_GROUP_ID=-1001234567890

# Sandbox Supergroup ID (isolated group for testing roles & permissions)
SANDBOX_GROUP_ID=-1009876543210

# Forum Topic IDs in Main Supergroup
OPERATIONAL_LOGS_TOPIC_ID=10
BACKUPS_TOPIC_ID=20
ADMIN_DM_LOGS_TOPIC_ID=0

# Local Storage Paths
DB_PATH=./data/agent_bot.db
BACKUP_DIR=./backups

# Directory containing Hermes server-side helper modules (not included in this repository)
HSTAGENTBOT_INTEGRATIONS_PATH=/root/.hermes/scripts

# Public subscription URL (set to the actual deployed domain)
SUB_DOMAIN=
SUB_PORT=443
SUB_PATH=sub
